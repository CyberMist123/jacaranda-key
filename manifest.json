{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.5.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "permissions": [
    "alarms",
    "storage",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "https://sso.sydney.edu.au/*",
    "https://canvas.sydney.edu.au/*",
    "https://*.openathens.net/*",
    "https://sydney.primo.exlibrisgroup.com/*"
  ],
  "incognito": "split",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Jacaranda Key",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sso.sydney.edu.au/*"
      ],
      "js": [
        "content-okta.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://login.openathens.net/*"
      ],
      "js": [
        "content-openathens.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
